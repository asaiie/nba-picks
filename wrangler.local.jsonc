{
  "name": "nba-picks",
  "compatibility_date": "2026-10-19",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nba-picks",
      "database_id": "nba-picks"
    }
  ],
  "main": "worker.js",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "build": {
    "command": "npm run build"
  }
}
